"""
DMBI Experiment 7
Bank Customer Churn System
K-Means Clustering using Python (RapidMiner workflow equivalent)

Input: Churn_Modelling.csv
K: 4
Selected features: 8 numerical customer attributes
"""

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score, davies_bouldin_score
from scipy.spatial.distance import cdist

# ------------------------------------------------------------
# STEP 1: RETRIEVE / LOAD DATASET
# ------------------------------------------------------------
# Google Colab upload support; local execution reads from this folder.
try:
    from google.colab import files
    uploaded = files.upload()
    filename = next(iter(uploaded))
except ImportError:
    filename = "Churn_Modelling.csv"

df = pd.read_csv(filename)

print("Bank Customer Churn System dataset loaded.")
print("Dataset shape:", df.shape)
print("\nFirst five records:")
print(df.head())
print("\nMissing values:")
print(df.isnull().sum())

# ------------------------------------------------------------
# STEP 2: SELECT ATTRIBUTES
# Retain only the eight numerical features used in the practical.
# Exited is deliberately excluded from clustering.
# ------------------------------------------------------------
features = [
    "CreditScore",
    "Age",
    "Tenure",
    "Balance",
    "NumOfProducts",
    "HasCrCard",
    "IsActiveMember",
    "EstimatedSalary"
]

missing_columns = [col for col in features if col not in df.columns]
if missing_columns:
    raise ValueError(f"Missing required dataset columns: {missing_columns}")

X = df[features].copy()

# ------------------------------------------------------------
# STEP 3: REPLACE MISSING VALUES
# RapidMiner procedure specifies average replacement for numerical data.
# ------------------------------------------------------------
X = X.fillna(X.mean())

# ------------------------------------------------------------
# STEP 4: NORMALIZE USING Z-TRANSFORMATION
# StandardScaler performs (x - mean) / standard deviation.
# ------------------------------------------------------------
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

print("\nSelected attributes:", features)
print("Selected data shape:", X.shape)
print("Z-transformation completed.")

# ------------------------------------------------------------
# STEP 5: APPLY K-MEANS (K = 4)
# ------------------------------------------------------------
K = 4

kmeans = KMeans(
    n_clusters=K,
    random_state=42,
    n_init=10
)

cluster_labels = kmeans.fit_predict(X_scaled)

# Use RapidMiner-like cluster labels in the output dataset.
df_clustered = df.copy()
df_clustered["Cluster"] = [f"cluster_{label}" for label in cluster_labels]
